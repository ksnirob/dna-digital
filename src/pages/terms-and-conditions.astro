---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const sections = [
  {
    num: '1.',
    title: 'AGREEMENT TO TERMS',
    content: {
      type: 'dropcap',
      dropcap: 'B',
      text: 'y accessing the website of Dna Digital Consultancy (\u201cthe Firm\u201d), a DBA of Dna Web Solutions, Inc., you agree to be bound by these Terms and Conditions. Our engagement is built on a foundation of integrity and proactive risk anticipation; we expect the same level of commitment from our digital visitors and clients. If you do not agree with all of these terms, you are prohibited from using the site.',
    },
  },
  {
    num: '2.',
    title: 'INTELLECTUAL PROPERTY RIGHTS',
    content: {
      type: 'paragraph',
      text: 'The \u201cArchitectural Plates,\u201d custom software frameworks, CRM logic, and all visual designs (including the glassmorphism UI and Dna Digital branding) are the proprietary property of the Firm. You are granted a limited license to access the site for informational purposes. No part of our \u201cEngineered Outcomes\u201d or technical specs may be copied, reproduced, or exploited for commercial purposes without express written consent.',
    },
  },
  {
    num: '3.',
    title: 'PROFESSIONAL SERVICES & ENGAGEMENT',
    content: {
      type: 'paragraph',
      text: 'Consultancy services\u2014including AI Strategy, Technology Leadership, and Product Engineering\u2014are subject to individual Master Service Agreements (MSAs). The information on this site is for promotional and educational purposes and does not constitute a binding contract for delivery until a formal Statement of Work (SOW) is executed.',
    },
  },
  {
    num: '4.',
    title: 'LIMITATION OF LIABILITY',
    content: {
      type: 'leftborder',
      boldLabel: 'NOTICE OF RISK:',
      text: ' Dna Digital Consultancy provides technical oversight to anticipate issues before they impact momentum. However, the Firm shall not be liable for any indirect, consequential, or incidental damages resulting from the use of our digital content or the implementation of suggested architectural patterns by third parties.',
    },
  },
  {
    num: '5.',
    title: 'USER CONDUCT',
    content: {
      type: 'paragraph',
      text: 'We measure success by the resilience of our solutions. Users are prohibited from attempting to reverse-engineer our mobile apps, CRM intelligence, or website code, or attempting to breach the \u201cmilitary-grade\u201d security measures protecting our infrastructure.',
    },
  },
  {
    num: '6.',
    title: 'GOVERNING LAW',
    content: {
      type: 'paragraph',
      text: 'These terms are governed by the laws of the State of California. Any structural disputes or legal missions arising from these terms shall be resolved in the courts of Los Angeles County.',
    },
  },
  {
    num: '7.',
    title: 'TERMINATION',
    content: {
      type: 'paragraph',
      text: 'We reserve the right to terminate access to our digital platforms at our sole discretion, without notice, for conduct that we believe violates these Terms or is harmful to the integrity of the Dna Digital Consultancy brand.',
    },
  },
];
---

<Layout
  title="Terms & Conditions | DNA Digital Consultancy"
  description="Terms and Conditions for DNA Digital Consultancy — the rules governing use of our website and professional services."
>
  <Nav />
  <main>

    <!-- HERO -->
    <section
      class="relative w-full overflow-hidden flex items-center justify-center"
      style="height: 440px; background-color: #060505;"
    >
      <!-- Background image -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/hero-bg.jpg"
          alt=""
          class="w-full h-full object-cover object-center"
          style="filter: brightness(0.45) saturate(0.6) contrast(1.1);"
        />
        <div
          class="absolute inset-0"
          style="background: linear-gradient(to bottom, rgba(6,5,5,0.60) 0%, rgba(6,5,5,0.55) 100%);"
        ></div>
      </div>

      <!-- Hero Text -->
      <div class="relative z-10 text-center px-8">
        <h1
          class="font-montserrat font-semibold text-white mb-4"
          style="font-size: 72px; line-height: 1.2; letter-spacing: -0.04em;"
        >
          TERMS &amp; CONDITIONS
        </h1>
        <p
          class="font-merriweather font-medium"
          style="font-size: 20px; line-height: 36px; color: #91836C;"
        >
          Last Updated: October 15, 2025
        </p>
      </div>
    </section>

    <!-- CONTENT BODY -->
    <section class="w-full bg-white py-[144px]">
      <div class="section-container">
        <div class="mx-auto" style="max-width: 900px;">
          <div class="flex flex-col" style="gap: 96px;">

            {sections.map((section) => (
              <div>
                <!-- Section Heading Row -->
                <div
                  class="flex items-center gap-1 pb-3 mb-6"
                  style="border-bottom: 1px solid #E2DED6;"
                >
                  <span
                    class="font-montserrat font-semibold"
                    style="font-size: 28px; line-height: 47.2px; color: #2A2A2A; font-variant: small-caps;"
                  >
                    {section.num}
                  </span>
                  <span
                    class="font-montserrat font-semibold ml-1"
                    style="font-size: 28px; line-height: 47.2px; color: #2A2A2A; font-variant: small-caps;"
                  >
                    {section.title}
                  </span>
                </div>

                <!-- Section Body -->
                {section.content.type === 'dropcap' && (
                  <div
                    class="font-merriweather text-[18px] leading-[30.6px] overflow-hidden"
                    style="color: rgba(42,42,42,0.88);"
                  >
                    <span
                      class="float-left font-normal mr-2"
                      style="font-family: Merriweather, serif; font-size: 60px; color: #91836C; line-height: 1.0; margin-top: 4px;"
                    >
                      {section.content.dropcap}
                    </span>
                    {section.content.text}
                  </div>
                )}

                {section.content.type === 'paragraph' && (
                  <p
                    class="font-merriweather text-[18px] leading-[30.6px]"
                    style="color: rgba(42,42,42,0.88);"
                  >
                    {section.content.text}
                  </p>
                )}

                {section.content.type === 'leftborder' && (
                  <div class="pl-7" style="border-left: 4px solid #91836C;">
                    <p
                      class="font-merriweather text-[18px] leading-[30.6px]"
                      style="color: rgba(42,42,42,0.88);"
                    >
                      <strong class="font-bold">{section.content.boldLabel}</strong>
                      {section.content.text}
                    </p>
                  </div>
                )}

              </div>
            ))}

          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
