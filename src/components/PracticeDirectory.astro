---
const cards = [
  {
    num: '01',
    title: 'AI Strategy & Transformation',
    description:
      'We help organizations understand where AI fits, what’s possible, and how to move forward with clarity and confidence, and that means we help:',
    headerColor: '#818A79',
    icon: 'strategy',
  },
  {
    num: '02',
    title: 'Technology Leadership & Governance',
    description:
      'We provide the senior-level oversight, judgment, and governance needed to ensure technology and AI initiatives are safe, feasible, and aligned with organizational goals, which means we help:',
    headerColor: '#887660',
    icon: 'leadership',
  },
  {
    num: '03',
    title: 'AI-Powered Growth & Experience',
    description:
      'We help brands scale content, engagement, and growth using intelligent systems that amplify creativity and accelerate performance. To deliver on that, we help:',
    headerColor: '#75867E',
    icon: 'growth',
  },
  {
    num: '04',
    title: 'Solution & Product Engineering',
    description:
      'We design and build modern digital products and AI-enabled applications that are scalable, secure, and ready for real-world use. To make that possible, we help:',
    headerColor: '#6A747D',
    icon: 'solution',
  },
  {
    num: '05',
    title: 'Enterprise Digital & Technology Transformation',
    description:
      'We modernize legacy systems, implement enterprise platforms, and guide organizations through complex technology transitions. To support that evolution, we help:',
    headerColor: '#86845E',
    icon: 'enterprise',
  },
  {
    num: '06',
    title: 'AI Micro-Agents & CRM Intelligence',
    description:
      'We deploy intelligent agents and CRM-powered automation that enhance customer engagement, streamline operations, and scale personalized experiences. To deliver on that, we help:',
    headerColor: '#828A7B',
    icon: 'agents',
  },
  {
    num: '07',
    title: 'Digital Execution & Delivery Enablement',
    description:
      'We provide the architecture, engineering capacity, and delivery leadership needed to execute digital and AI initiatives with speed and quality. To ensure that happens, we help:',
    headerColor: '#968C80',
    icon: 'delivery',
  },
];

const row1 = cards.slice(0, 3);
const row2 = cards.slice(3);
---

<section id="practices" class="w-full py-[100px]" style="background-color: #F5F1EA;">
  <div class="section-container">
    <div class="text-center mb-14">
      <h2 class="font-montserrat font-bold leading-tight mb-4" style="font-size: 40px; color: #4E5854; font-variant: small-caps;">Practice Directory</h2>
      <div class="flex justify-center mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="208" height="28" viewBox="0 0 208 28" fill="none" aria-hidden="true">
          <g clip-path="url(#clip0_practice_directory)">
            <path d="M117.338 14.0294L104.309 1L91.2797 14.0294L104.309 27.0588L117.338 14.0294Z" stroke="#796D56" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/>
            <path d="M113.948 14.0295L104.309 4.39062L94.6702 14.0295L104.309 23.6683L113.948 14.0295Z" fill="#766B53"/>
            <path d="M3 14L74 14" stroke="#796D56" stroke-width="5" stroke-miterlimit="10" stroke-linecap="round"/>
            <path d="M134 13H205" stroke="#796D56" stroke-width="5" stroke-miterlimit="10" stroke-linecap="round"/>
          </g>
          <defs>
            <clipPath id="clip0_practice_directory">
              <rect width="208" height="28" fill="white"/>
            </clipPath>
          </defs>
        </svg>
      </div>
      <h3 class="font-montserrat text-[24px] font-semibold leading-[28.8px] mb-5" style="color: #2A2A2A;">Our Expertise at a Glance</h3>
      <p class="font-merriweather text-[18px] font-normal leading-[30.6px] max-w-[860px] mx-auto" style="color: #2A2A2A;">Our practice areas form a complete end-to-end capability system that give our clients a comprehensive partner equipped to guide the entire lifecycle of modern digital work.</p>
    </div>

    <!-- Row 1: 3 cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      {row1.map((card) => (
        <article class="practice-card flex h-full min-h-[296px] flex-col overflow-hidden rounded-[8px] bg-white shadow-[0_4px_18px_rgba(42,42,42,0.12)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_28px_rgba(42,42,42,0.16)]">
          <div class="flex h-16 items-center justify-between px-5" style={`background-color: ${card.headerColor};`}>
            <div class="flex h-10 w-10 items-center justify-center text-white/95">
              {card.icon === 'strategy' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6.5H10.5V11H6V6.5Z" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M6 13H10.5V17.5H6V13Z" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M13 8.75H18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M13 15.25H18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M12 12L15 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <circle cx="17.5" cy="17.5" r="2.75" stroke="currentColor" stroke-width="1.7"/>
                </svg>
              )}
              {card.icon === 'leadership' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="7" r="3.5" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M6 19V17.5C6 15.2909 7.79086 13.5 10 13.5H14C16.2091 13.5 18 15.2909 18 17.5V19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M4.5 11.5H7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M17 11.5H19.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              )}
              {card.icon === 'growth' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 18.5H19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <rect x="6" y="10" width="2.8" height="6" stroke="currentColor" stroke-width="1.7"/>
                  <rect x="10.6" y="7" width="2.8" height="9" stroke="currentColor" stroke-width="1.7"/>
                  <rect x="15.2" y="12" width="2.8" height="4" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M15 6L18.5 6L18.5 9.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M18.5 6L13.5 11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              )}
            </div>
            <span class="font-montserrat text-[16px] font-bold leading-6 text-white">{card.num}</span>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h4 class="mb-2 font-montserrat text-[16px] font-semibold leading-6" style="color: #060505;">{card.title}</h4>
            <p class="font-merriweather text-[14px] font-normal leading-[23.8px]" style="color: #2A2A2A;">{card.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Row 2: 4 cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-14">
      {row2.map((card) => (
        <article class="practice-card flex h-full min-h-[296px] flex-col overflow-hidden rounded-[8px] bg-white shadow-[0_4px_18px_rgba(42,42,42,0.12)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_28px_rgba(42,42,42,0.16)]">
          <div class="flex h-16 items-center justify-between px-5" style={`background-color: ${card.headerColor};`}>
            <div class="flex h-10 w-10 items-center justify-center text-white/95">
              {card.icon === 'solution' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 6.5H17L19 10V17.5H5V10L7 6.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M5 10H19" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M9 13H15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              )}
              {card.icon === 'enterprise' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 8.5H20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M6.5 8.5V18" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M12 8.5V18" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M17.5 8.5V18" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M3.5 18H20.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M8 5.5H16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              )}
              {card.icon === 'agents' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 4.5L15.5 6.5V10.5L12 12.5L8.5 10.5V6.5L12 4.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M8 15L12 12.5L16 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <rect x="8.5" y="15.5" width="7" height="4" rx="1" stroke="currentColor" stroke-width="1.7"/>
                </svg>
              )}
              {card.icon === 'delivery' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 4.5L13.6 7.7L17 8.2L14.5 10.6L15.1 14L12 12.4L8.9 14L9.5 10.6L7 8.2L10.4 7.7L12 4.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M12 15.5V19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M9.5 17.5H14.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              )}
            </div>
            <span class="font-montserrat text-[16px] font-bold leading-6 text-white">{card.num}</span>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h4 class="mb-2 font-montserrat text-[16px] font-semibold leading-6" style="color: #060505;">{card.title}</h4>
            <p class="font-merriweather text-[14px] font-normal leading-[23.8px]" style="color: #2A2A2A;">{card.description}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center">
      <p class="font-merriweather text-[20px] font-normal leading-[28px]" style="color: #2A2A2A;">
        Not sure where to start? Our <a href="#expertise" class="font-semibold underline" style="color: #683547;">AI Concierge</a> can help you.
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo('.practice-card', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.07, ease: 'power2.out', scrollTrigger: { trigger: '#practices', start: 'top 80%' } });
</script>