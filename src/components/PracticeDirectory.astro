---
const cards = [
  {
    num: '01',
    title: 'AI Strategy & Transformation',
    description:
      'We help organizations understand where AI fits, what’s possible, and how to move forward with clarity and confidence, and that means we help:',
    headerColor: '#818A79',
    iconSrc: '/images/practices/icons/icon-1.svg',
  },
  {
    num: '02',
    title: 'Technology Leadership & Governance',
    description:
      'We provide the senior-level oversight, judgment, and governance needed to ensure technology and AI initiatives are safe, feasible, and aligned with organizational goals, which means we help:',
    headerColor: '#887660',
    iconSrc: '/images/practices/icons/icon-2.svg',
  },
  {
    num: '03',
    title: 'AI-Powered Growth & Experience',
    description:
      'We help brands scale content, engagement, and growth using intelligent systems that amplify creativity and accelerate performance. To deliver on that, we help:',
    headerColor: '#75867E',
    iconSrc: '/images/practices/icons/icon-3.svg',
  },
  {
    num: '04',
    title: 'Solution & Product Engineering',
    description:
      'We design and build modern digital products and AI-enabled applications that are scalable, secure, and ready for real-world use. To make that possible, we help:',
    headerColor: '#6A747D',
    iconSrc: '/images/practices/icons/icon-4.svg',
  },
  {
    num: '05',
    title: 'Enterprise Digital & Technology Transformation',
    description:
      'We modernize legacy systems, implement enterprise platforms, and guide organizations through complex technology transitions. To support that evolution, we help:',
    headerColor: '#86845E',
    iconSrc: '/images/practices/icons/icon-5.svg',
  },
  {
    num: '06',
    title: 'AI Micro-Agents & CRM Intelligence',
    description:
      'We deploy intelligent agents and CRM-powered automation that enhance customer engagement, streamline operations, and scale personalized experiences. To deliver on that, we help:',
    headerColor: '#828A7B',
    iconSrc: '/images/practices/icons/icon-6.svg',
  },
  {
    num: '07',
    title: 'Digital Execution & Delivery Enablement',
    description:
      'We provide the architecture, engineering capacity, and delivery leadership needed to execute digital and AI initiatives with speed and quality. To ensure that happens, we help:',
    headerColor: '#968C80',
    iconSrc: '/images/practices/icons/icon-7.svg',
  },
];

const row1 = cards.slice(0, 3);
const row2 = cards.slice(3);
---

<section id="practices" class="w-full py-[100px]" style="background-color: #F5F1EA;">
  <div class="section-container">
    <div class="text-center mb-14">
      <h2 class="font-montserrat font-bold leading-tight mb-4" style="font-size: 40px; color: #4E5854; font-variant: small-caps;">Practice Directory</h2>
      <div class="flex justify-center mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="208" height="28" viewBox="0 0 208 28" fill="none" aria-hidden="true">
          <g clip-path="url(#clip0_practice_directory)">
            <path d="M117.338 14.0294L104.309 1L91.2797 14.0294L104.309 27.0588L117.338 14.0294Z" stroke="#796D56" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/>
            <path d="M113.948 14.0295L104.309 4.39062L94.6702 14.0295L104.309 23.6683L113.948 14.0295Z" fill="#766B53"/>
            <path d="M3 14L74 14" stroke="#796D56" stroke-width="5" stroke-miterlimit="10" stroke-linecap="round"/>
            <path d="M134 13H205" stroke="#796D56" stroke-width="5" stroke-miterlimit="10" stroke-linecap="round"/>
          </g>
          <defs>
            <clipPath id="clip0_practice_directory">
              <rect width="208" height="28" fill="white"/>
            </clipPath>
          </defs>
        </svg>
      </div>
      <h3 class="font-montserrat text-[24px] font-semibold leading-[28.8px] mb-5" style="color: #2A2A2A;">Our Expertise at a Glance</h3>
      <p class="font-merriweather text-[18px] font-normal leading-[30.6px] max-w-[860px] mx-auto" style="color: #2A2A2A;">Our practice areas form a complete end-to-end capability system that give our clients a comprehensive partner equipped to guide the entire lifecycle of modern digital work.</p>
    </div>

    <div class="practice-desktop-content">
    <!-- Row 1: 3 cards -->
    <div class="mx-auto grid max-w-[904px] grid-cols-1 gap-8 mb-8 md:grid-cols-3">
      {row1.map((card) => (
        <article class="practice-card flex h-full min-h-[296px] flex-col overflow-hidden rounded-t-[8px] bg-white shadow-[0_6px_12px_-2px_rgba(0,0,0,0.09),0_1px_3px_rgba(0,0,0,0.08)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_28px_-4px_rgba(0,0,0,0.15)]">
          <div class="flex h-16 items-center justify-between px-4" style={`background-color: ${card.headerColor};`}>
            <div class="flex h-10 w-10 items-center justify-center">
              <img src={card.iconSrc} alt="" class="h-10 w-10 object-contain" loading="lazy" aria-hidden="true" />
            </div>
            <span class="font-montserrat text-[16px] font-bold leading-6 text-white">{card.num}</span>
          </div>
          <div class="flex flex-1 flex-col px-4 pb-4 pt-3">
            <h4 class="mb-3 font-montserrat text-[16px] font-semibold leading-6" style="color: #060505;">{card.title}</h4>
            <p class="font-merriweather text-[14px] font-normal leading-[23.8px]" style="color: #2A2A2A;">{card.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Row 2: 4 cards -->
    <div class="mx-auto grid max-w-[1216px] grid-cols-1 gap-8 mb-14 sm:grid-cols-2 lg:grid-cols-4">
      {row2.map((card) => (
        <article class="practice-card flex h-full min-h-[296px] flex-col overflow-hidden rounded-t-[8px] bg-white shadow-[0_6px_12px_-2px_rgba(0,0,0,0.09),0_1px_3px_rgba(0,0,0,0.08)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_28px_-4px_rgba(0,0,0,0.15)]">
          <div class="flex h-16 items-center justify-between px-4" style={`background-color: ${card.headerColor};`}>
            <div class="flex h-10 w-10 items-center justify-center">
              <img src={card.iconSrc} alt="" class="h-10 w-10 object-contain" loading="lazy" aria-hidden="true" />
            </div>
            <span class="font-montserrat text-[16px] font-bold leading-6 text-white">{card.num}</span>
          </div>
          <div class="flex flex-1 flex-col px-4 pb-4 pt-3">
            <h4 class="mb-3 font-montserrat text-[16px] font-semibold leading-6" style="color: #060505;">{card.title}</h4>
            <p class="font-merriweather text-[14px] font-normal leading-[23.8px]" style="color: #2A2A2A;">{card.description}</p>
          </div>
        </article>
      ))}
    </div>
    </div>

    <!-- Mobile slider -->
    <div class="practice-mobile-carousel" style="display: none; max-width: 350px; margin: 0 auto 32px;">
      <div style="position: relative; width: 100%; min-height: 228px;">
        {cards.map((card, i) => (
          <article
            class="practice-mobile-card practice-card flex h-full min-h-[228px] flex-col overflow-hidden rounded-t-[8px] bg-white shadow-[0_6px_12px_-2px_rgba(0,0,0,0.09),0_1px_3px_rgba(0,0,0,0.08)]"
            data-mobile-card={i}
            style={`display: ${i === 0 ? 'flex' : 'none'};`}
          >
            <div class="flex h-16 items-center justify-between px-4" style={`background-color: ${card.headerColor};`}>
              <div class="flex h-10 w-10 items-center justify-center">
                <img src={card.iconSrc} alt="" class="h-10 w-10 object-contain" loading="lazy" aria-hidden="true" />
              </div>
              <span class="font-montserrat text-[16px] font-bold leading-6 text-white">{card.num}</span>
            </div>
            <div class="flex flex-1 flex-col px-4 pb-4 pt-3">
              <h4 class="mb-2 font-montserrat text-[16px] font-semibold leading-6" style="color: #060505;">{card.title}</h4>
              <p class="font-merriweather text-[14px] font-normal leading-[23.8px]" style="color: #2A2A2A;">{card.description}</p>
            </div>
          </article>
        ))}
      </div>

      <div style="display: flex; justify-content: center; gap: 16px; margin-top: 20px;">
        <button id="practice-mobile-prev" aria-label="Previous practice" style="width: 56px; height: 56px; border-radius: 50%; border: none; cursor: pointer; background: #C4BCAD; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button id="practice-mobile-next" aria-label="Next practice" style="width: 56px; height: 56px; border-radius: 50%; border: none; cursor: pointer; background: #968C80; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="text-center">
      <p class="font-merriweather text-[20px] font-normal leading-[28px]" style="color: #2A2A2A;">
        Not sure where to start? Our <a href="#" data-open-ai-concierge class="font-semibold underline" style="color: #683547;">AI Concierge</a> can help you.
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo('.practice-card', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.07, ease: 'power2.out', scrollTrigger: { trigger: '#practices', start: 'top 80%' } });

  const mobileCards = document.querySelectorAll<HTMLElement>('.practice-mobile-card');
  const prevBtn = document.getElementById('practice-mobile-prev');
  const nextBtn = document.getElementById('practice-mobile-next');
  let mobileIndex = 0;

  function showMobileCard(index: number) {
    if (!mobileCards.length) return;
    mobileIndex = ((index % mobileCards.length) + mobileCards.length) % mobileCards.length;
    mobileCards.forEach((card, i) => {
      card.style.display = i === mobileIndex ? 'flex' : 'none';
    });
  }

  prevBtn?.addEventListener('click', () => showMobileCard(mobileIndex - 1));
  nextBtn?.addEventListener('click', () => showMobileCard(mobileIndex + 1));
  showMobileCard(0);
</script>

<style>
@media (max-width: 768px) {
  #practices {
    padding-top: 80px !important;
    padding-bottom: 80px !important;
  }

  #practices .practice-desktop-content {
    display: none;
  }

  #practices .practice-mobile-carousel {
    display: block !important;
  }

  #practices h2 {
    font-size: 28px !important;
    line-height: 36px !important;
  }

  #practices h3 {
    font-size: 18px !important;
    line-height: 28px !important;
  }

  #practices p.font-merriweather.text-\[18px\] {
    font-size: 14px !important;
    line-height: 27.2px !important;
    max-width: 350px;
  }
}
</style>