---
// About Federal & Enterprise Readiness — bg #E9E4DD

const naicsCategories = [
  {
    label: 'Primary NAICS',
    items: ['541512 | Computer Systems Design Services'],
  },
  {
    label: 'Core Technical',
    items: [
      '541511 | Custom Computer Programming Services',
      '541519 | Other Computer Related Services',
      '541513 | Computer Facilities Management Services',
      '518210 | Computing Infrastructure Providers, Data Processing, Web Hosting',
      '519190 | All Other Information Services',
    ],
  },
  {
    label: 'Consulting, Leadership & Governance',
    items: [
      '541611 | Administrative & Management Consulting Services',
      '541618 | Other Management Consulting Services',
      '541614 | Process, Distribution & Logistics Consulting',
    ],
  },
  {
    label: 'AI, Automation & Analytics',
    items: [
      '541715 | R&D in Physical, Engineering, and Life Sciences',
      '541690 | Other Scientific & Technical Consulting Services',
      '541720 | R&D in Social Sciences & Humanities',
    ],
  },
  {
    label: 'Training & Enablement',
    items: [
      '611420 | Computer Training',
      '611430 | Professional & Management Development Training',
    ],
  },
  {
    label: 'Creative, CX, and Digital Experience',
    items: [
      '541430 | Graphic Design Services',
      '541613 | Marketing Consulting Services',
      '541810 | Advertising Services',
    ],
  },
];

const systemData = [
  { label: 'SAM Status', value: 'Active', mono: false },
  { label: 'UEI', value: 'MQNMTNP46YT4', mono: true },
  { label: 'CAGE Code', value: '1ARP7', mono: true },
];
---

<section id="about-federal" class="w-full py-[100px]" style="background-color: #E9E4DD;">
  <div class="section-container">

    <!-- Section Header -->
    <div class="text-center mb-14 max-w-[820px] mx-auto">
      <h2
        class="font-montserrat font-semibold mb-5"
        style="font-size: 28px; color: #2A2A2A; font-variant: small-caps; letter-spacing: 0.05em;"
      >
        Federal &amp; Enterprise Readiness
      </h2>
      <!-- Diamond Ornament -->
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="h-px w-[120px]" style="background-color: #766B58; opacity: 0.7;"></div>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <rect x="9" y="0" width="9" height="9" transform="rotate(45 9 0)" fill="#766B58" opacity="0.85"/>
        </svg>
        <div class="h-px w-[120px]" style="background-color: #766B58; opacity: 0.7;"></div>
      </div>
      <h3
        class="font-montserrat font-semibold mb-4"
        style="font-size: 20px; color: #2A2A2A;"
      >
        Institutional Data and Compliance Classifications
      </h3>
      <p
        class="font-merriweather text-[16px] leading-[28px]"
        style="color: #2A2A2A; opacity: 0.85;"
      >
        Official registration and system data for public sector, federal, and highly regulated commercial engagements.
      </p>
    </div>

    <!-- Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-[3fr_1fr] gap-12 xl:gap-20 items-start">

      <!-- LEFT: NAICS Classifications -->
      <div>
        <h3
          class="font-montserrat font-semibold mb-6"
          style="font-size: 20px; color: #060505; font-variant: small-caps; letter-spacing: 0.05em;"
        >
          NAICS Classifications
        </h3>
        <div>
          {naicsCategories.map((cat, ci) => (
            <div
              class="py-3"
              style={ci < naicsCategories.length - 1 ? 'border-bottom: 1px solid rgba(145,131,108,0.5);' : ''}
            >
              <div class="flex gap-5 items-start">
                <!-- Category label -->
                <div class="flex-shrink-0" style="width: 160px;">
                  <span
                    class="font-merriweather font-bold text-[13px] leading-[22px]"
                    style="color: #2A2A2A;"
                  >
                    {cat.label}
                  </span>
                </div>
                <!-- Code items -->
                <div class="flex-1">
                  {cat.items.map((item, ii) => (
                    <div
                      class="font-merriweather text-[13px] leading-[22px] py-[3px]"
                      style={`color: #2A2A2A; opacity: 0.88; ${ii < cat.items.length - 1 ? 'border-bottom: 1px solid rgba(145,131,108,0.3);' : ''}`}
                    >
                      {item}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- RIGHT: System Data -->
      <div>
        <h3
          class="font-montserrat font-semibold mb-6"
          style="font-size: 20px; color: #060505; font-variant: small-caps; letter-spacing: 0.05em;"
        >
          System Data
        </h3>
        <div>
          {systemData.map((item, i) => (
            <div
              class="py-3"
              style={i < systemData.length - 1 ? 'border-bottom: 1px solid rgba(145,131,108,0.5);' : ''}
            >
              <p
                class="font-merriweather text-[13px] leading-[22px]"
                style="color: #2A2A2A;"
              >
                <span class="font-bold">{item.label}:</span>
                {' '}
                <span class={item.mono ? 'font-mono tracking-wide' : ''}>{item.value}</span>
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
