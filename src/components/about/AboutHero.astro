---
// About Hero — full-bleed background image with dark overlay
---

<section
  id="about-hero"
  class="relative w-full min-h-screen overflow-hidden flex items-center"
  style="background-color: #060505;"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-bg.jpg"
      alt="DNA Digital Consultancy"
      class="w-full h-full object-cover object-center"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, rgba(6,5,5,0.78) 0%, rgba(6,5,5,0.68) 100%);"
    ></div>
  </div>

  <!-- Content -->
  <div class="section-container relative z-10 pt-[160px] pb-24">
    <div class="w-full flex flex-col items-center text-center">

      <!-- Main Heading -->
      <h1
        id="about-hero-heading"
        class="font-montserrat font-semibold text-white mb-6 opacity-0"
        style="font-size: clamp(36px, 5vw, 72px); line-height: 1.15; max-width: 960px; letter-spacing: 0.03em;"
      >
        PARTNERSHIPS BUILT ON TRUST.<br />SYSTEMS BUILT ON EXCELLENCE.
      </h1>

      <!-- Gold Subtitle -->
      <p
        id="about-hero-subtitle"
        class="font-montserrat font-medium tracking-widest uppercase mb-10 opacity-0"
        style="font-size: 20px; color: #91836C; letter-spacing: 0.1em;"
      >
        Engineering Resilience into the Digital Dna
      </p>

      <!-- Badge Pills -->
      <div
        id="about-hero-badges"
        class="flex flex-wrap items-center justify-center gap-4 mb-10 opacity-0"
      >
        <span
          class="font-montserrat text-[13px] font-semibold px-5 py-[10px] bg-white text-black"
          style="letter-spacing: 0.06em;"
        >SDVOSB Certified</span>
        <span
          class="font-montserrat text-[13px] font-semibold px-5 py-[10px] bg-white text-black"
          style="letter-spacing: 0.06em;"
        >Professionally Certified</span>
        <span
          class="font-montserrat text-[13px] font-semibold px-5 py-[10px] bg-white text-black"
          style="letter-spacing: 0.06em;"
        >30+ Years Experience</span>
      </div>

      <!-- CTA Button -->
      <a
        id="about-hero-cta"
        href="#contact"
        class="inline-flex items-center justify-center font-montserrat font-semibold tracking-[0.12em] uppercase px-10 py-[14px] transition-all duration-300 opacity-0"
        style="font-size: 13px; background-color: #fff; color: #060505; letter-spacing: 0.12em;"
        onmouseover="this.style.backgroundColor='rgba(255,255,255,0.88)'"
        onmouseout="this.style.backgroundColor='#fff'"
      >
        Initiate a Strategic Review
      </a>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const tl = gsap.timeline({ delay: 0.3 });
  tl.fromTo(
    '#about-hero-heading',
    { opacity: 0, y: 60 },
    { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out' }
  )
    .fromTo(
      '#about-hero-subtitle',
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },
      '-=0.6'
    )
    .fromTo(
      '#about-hero-badges',
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' },
      '-=0.5'
    )
    .fromTo(
      '#about-hero-cta',
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' },
      '-=0.4'
    );
</script>
