---
// About Credentials & Compliance — white bg + dark card with 3 columns

const certifications = [
  'PMI Project Management Professional (PMP)',
  'TOGAF Certification',
  'AWS Certified SysOps Admin Associate (SOAA)',
  'PMI-CPMAI Certified Professional in Managing AI Projects (CPMAI)',
  'AWS Certified Developer Associate',
  'PMI-PMP Certified Project Management Professional (PMP)',
  'Sitecore Certified Experience Solution Developer 9.2 (SESD)',
  'Certified Professional Scrum Master (PSM)',
  'Sitecore Certified Professional 7.2 (SCP)',
  'SAFE Scrum Master (SSM)',
  'AWS Certified AI Practitioner',
  'AWS Certified Machine Learning Engineer – Associate (MLEA)',
  'AWS Certified Solution Architect Associate (SAA)',
];

const complianceItems = [
  'FAR/DEARS compliance posture',
  'NIST 800-17 framework alignment',
  'ISO 20022 ready systems',
];
---

<section id="about-credentials" class="w-full py-[100px] bg-white">
  <div class="section-container">

    <!-- Section Header -->
    <div class="text-center mb-14 max-w-[820px] mx-auto">
      <h2
        class="font-montserrat font-semibold mb-5"
        style="font-size: 28px; color: #2A2A2A; font-variant: small-caps; letter-spacing: 0.05em;"
      >
        Credentials &amp; Compliance
      </h2>
      <!-- Diamond Ornament -->
      <div class="flex items-center justify-center gap-3 mb-7">
        <div class="h-px w-[120px]" style="background-color: #766B58; opacity: 0.7;"></div>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <rect x="9" y="0" width="9" height="9" transform="rotate(45 9 0)" fill="#766B58" opacity="0.85"/>
        </svg>
        <div class="h-px w-[120px]" style="background-color: #766B58; opacity: 0.7;"></div>
      </div>
      <p
        class="font-merriweather italic text-[18px] leading-[30px] mb-4"
        style="color: #2A2A2A;"
      >
        In complex environments — federal, regulated, or enterprise — credibility is not optional. It is infrastructure.
      </p>
      <p
        class="font-merriweather text-[16px] leading-[28px]"
        style="color: #2A2A2A; opacity: 0.8;"
      >
        These credentials are not badges — they are the structural assurances that our work is built for environments where reliability, traceability, and accountability are non-negotiable.
      </p>
    </div>

    <!-- Dark 3-Column Card -->
    <div style="background-color: #1C1C1C;">
      <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x divide-white/10">

        <!-- Col 1: SDVOSB STATUS -->
        <div class="p-8 xl:p-10">
          <h3
            class="font-montserrat font-semibold text-white mb-6"
            style="font-size: 18px; font-variant: small-caps; letter-spacing: 0.08em;"
          >
            SDVOSB STATUS
          </h3>
          <!-- Badge icon -->
          <div class="w-16 h-16 mb-6 flex items-center justify-center" style="background-color: #91836C;">
            <svg class="w-9 h-9" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18 2L3 8v10c0 9.25 6.4 17.9 15 20 8.6-2.1 15-10.75 15-20V8L18 2z" fill="white" opacity="0.9"/>
              <path d="M12 18l4 4 8-8" stroke="#91836C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <p
            class="font-merriweather text-[14px] leading-[24px]"
            style="color: rgba(255,255,255,0.78);"
          >
            DNA Digital Consultancy is a verified Service-Disabled Veteran-Owned Small Business. This designation reflects our commitment to the mission and formalizes our capability to serve federal agencies, state entities, and heavily regulated corporate sectors. This status ensures that our operational discipline and architectural rigor meet the stringent requirements of government contracting and enterprise compliance.
          </p>
        </div>

        <!-- Col 2: CERTIFICATIONS -->
        <div class="p-8 xl:p-10">
          <h3
            class="font-montserrat font-semibold text-white mb-6"
            style="font-size: 18px; font-variant: small-caps; letter-spacing: 0.08em;"
          >
            CERTIFICATIONS
          </h3>
          <ul>
            {certifications.map((cert, i) => (
              <li
                class="font-merriweather text-[13px] leading-[22px] py-2"
                style={`color: rgba(255,255,255,0.78); ${i < certifications.length - 1 ? 'border-bottom: 1px solid rgba(145,131,108,0.35);' : ''}`}
              >
                {cert}
              </li>
            ))}
          </ul>
        </div>

        <!-- Col 3: COMPLIANCE-ALIGNED DELIVERY POSTURE -->
        <div class="p-8 xl:p-10">
          <h3
            class="font-montserrat font-semibold text-white mb-6"
            style="font-size: 18px; font-variant: small-caps; letter-spacing: 0.08em;"
          >
            COMPLIANCE-ALIGNED DELIVERY POSTURE
          </h3>
          <ul class="space-y-5">
            {complianceItems.map((item) => (
              <li class="flex items-start gap-3">
                <!-- Gold diamond bullet -->
                <span
                  class="flex-shrink-0 w-[10px] h-[10px] mt-[5px]"
                  style="background-color: #F0D09D; transform: rotate(45deg); display: inline-block;"
                ></span>
                <span
                  class="font-merriweather text-[14px] leading-[22px]"
                  style="color: rgba(255,255,255,0.78);"
                >
                  {item}
                </span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

  </div>
</section>
