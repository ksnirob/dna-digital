---
// Hero section — full bleed background image, dark overlay, white typography
---

<section id="hero" class="relative w-full min-h-screen overflow-hidden flex items-center" style="background-color: #1a1a1a;">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-bg.jpg"
      alt="DNA Digital Consultancy Background"
      class="w-full h-full object-cover object-center"
    />
    <!-- Overlay gradient: dark left, fading right -->
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(6,5,5,0.88) 30%, rgba(6,5,5,0.55) 65%, rgba(6,5,5,0.2) 100%);"></div>
  </div>

  <!-- Content -->
  <div class="section-container relative z-10 pt-[160px] pb-24">
    <div class="w-full flex flex-col items-center text-center">
      <!-- Main Heading -->
      <h1
        id="hero-heading"
        class="font-montserrat font-semibold text-white leading-[1.2] mb-8"
        style="font-size: clamp(40px, 5vw, 72px); max-width: 900px;"
      >
        Re-Engineering Your <em class="not-italic font-bold" style="text-decoration: underline; text-underline-offset: 6px;">Business</em> Dna to <em class="italic" style="color: #E0C9A3; text-decoration: underline; text-underline-offset: 6px;">Outperform</em><br />
        Your Competition
      </h1>

      <!-- Subtitle -->
      <div class="mb-10">
        <p
          id="hero-subtitle"
          class="font-merriweather text-[20px] font-normal leading-[36px] text-white/90"
          style="max-width: 700px;"
        >
          Strategic leadership and precision engineering for AI transformation, legacy modernization, and scalable growth.
        </p>
      </div>

      <!-- CTA Button -->
      <a
        id="hero-cta"
        href="#practices"
        class="inline-flex items-center justify-center font-montserrat text-[14px] font-semibold tracking-[0.12em] uppercase text-white px-10 py-[14px] transition-all duration-300 hover:bg-white/10"
        style="background-color: rgba(21,19,17,0.85); border: 1px solid rgba(255,255,255,0.45); letter-spacing: 0.12em;"
      >
        Explore a Potential Partnership
      </a>
    </div>
  </div>

  <!-- Bottom scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 opacity-60">
    <span class="font-montserrat text-[11px] text-white tracking-widest uppercase">Scroll</span>
    <div class="w-px h-8 bg-white/60 animate-pulse"></div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  // Hero entrance animations
  const tl = gsap.timeline({ delay: 0.3 });

  tl.fromTo(
    '#hero-heading',
    { opacity: 0, y: 60 },
    { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out' }
  )
  .fromTo(
    '#hero-subtitle',
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1, ease: 'power2.out' },
    '-=0.7'
  )
  .fromTo(
    '#hero-cta',
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },
    '-=0.5'
  );
</script>
