---
// Footer section — bg #5D5749

const practiceLinks = [
  { label: 'Overview', href: '#practices' },
  { label: 'AI Strategy & Transformation', href: '#expertise' },
  { label: 'Technology Leadership & Governance', href: '#expertise' },
  { label: 'AI Opportunity Review & ROI Analysis', href: '#expertise' },
  { label: 'Solution & Product Engineering', href: '#expertise' },
  { label: 'Enterprise Digital & Technology Transformation', href: '#expertise' },
  { label: 'AI Micro-Agents & CRM Intelligence', href: '#expertise' },
  { label: 'Digital Execution & Delivery Enablement', href: '#expertise' },
];

const productLinks = [
  { label: 'Sifter CRM', href: '#products' },
  { label: 'Mobile Apps', href: '#products' },
];

const socialIcons = [
  {
    label: 'Facebook',
    href: '#',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>`,
  },
  {
    label: 'LinkedIn',
    href: '#',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    label: 'YouTube',
    href: '#',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58 2.78 2.78 0 001.95 1.95C5.12 20 12 20 12 20s6.88 0 8.59-.47a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" style="fill:#5D5749"/></svg>`,
  },
  {
    label: 'X (Twitter)',
    href: '#',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
];
---

<footer id="footer" class="w-full" style="background-color: #5D5749; position: relative;">
  <!-- Texture overlay -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,...'); background-size: 200px;"></div>

  <div class="section-container relative z-10 pt-[80px] pb-[30px]">
    <!-- Top Section -->
    <div class="flex flex-col lg:flex-row gap-12 mb-16">
      <!-- Left: Logo + tagline + big text -->
      <div class="lg:w-[292px] flex-shrink-0">
        <img src="/images/logo.svg" alt="DNA Digital Consultancy" class="h-[160px] w-auto mb-2" />
      </div>

      <!-- Right: Big tagline + description -->
      <div class="flex-1 pt-2">
        <h2
          class="font-montserrat font-bold leading-[1.15] mb-4"
          style="font-size: clamp(28px, 3vw, 44px); color: #E0C9A3; font-variant: small-caps;"
        >
          Strategy. Execution. Transformation.
        </h2>
        <p class="font-merriweather text-[18px] font-semibold leading-[28px]" style="color: #E0C9A3;">
          Engineering resilience into the Digital DNA of enterprise systems for over 30 years.
        </p>
      </div>
    </div>

    <!-- Nav Links Row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-16 border-t pt-12" style="border-color: rgba(224,201,163,0.2);">
      <!-- Home -->
      <div>
        <h4 class="font-montserrat text-[14px] font-bold tracking-wider uppercase mb-4" style="color: #E0C9A3; font-variant: small-caps;">Home</h4>
      </div>

      <!-- Practices -->
      <div>
        <h4 class="font-montserrat text-[14px] font-bold tracking-wider uppercase mb-6" style="color: #E0C9A3; font-variant: small-caps;">Practices</h4>
        <ul class="space-y-3">
          {practiceLinks.map(link => (
            <li>
              <a href={link.href} class="font-montserrat text-[13px] font-normal leading-[19.6px] transition-colors duration-300 hover:text-dna-gold-light" style="color: rgba(224,201,163,0.75);">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Products -->
      <div>
        <h4 class="font-montserrat text-[14px] font-bold tracking-wider uppercase mb-6" style="color: #E0C9A3; font-variant: small-caps;">Products</h4>
        <ul class="space-y-3">
          {productLinks.map(link => (
            <li>
              <a href={link.href} class="font-montserrat text-[13px] font-normal leading-[19.6px] transition-colors duration-300 hover:text-dna-gold-light" style="color: rgba(224,201,163,0.75);">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- About -->
      <div>
        <h4 class="font-montserrat text-[14px] font-bold tracking-wider uppercase mb-6" style="color: #E0C9A3; font-variant: small-caps;">About</h4>

        <!-- HQ Box -->
        <div class="border p-4 mb-6" style="border-color: rgba(224,201,163,0.3);">
          <p class="font-montserrat text-[12px] font-bold uppercase tracking-wider mb-2" style="color: #E0C9A3; font-variant: small-caps;">Headquarters</p>
          <p class="font-merriweather text-[14px]" style="color: rgba(224,201,163,0.75);">Signal Hill, California</p>
        </div>

        <!-- Connect Box -->
        <div class="border p-4" style="border-color: rgba(224,201,163,0.3);">
          <p class="font-montserrat text-[12px] font-bold uppercase tracking-wider mb-3" style="color: #E0C9A3; font-variant: small-caps;">Connect</p>
          <a href="mailto:hello@Dnadigital.com" class="flex items-center gap-2 mb-4 hover:text-dna-gold-light transition-colors" style="color: rgba(224,201,163,0.75);">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/>
            </svg>
            <span class="font-montserrat text-[13px]">hello@Dnadigital.com</span>
          </a>
          <!-- Social Icons -->
          <div class="flex items-center gap-3">
            {socialIcons.map(social => (
              <a
                href={social.href}
                aria-label={social.label}
                class="w-9 h-9 rounded-full border flex items-center justify-center transition-all duration-300 hover:border-dna-gold-light hover:text-dna-gold-light"
                style="border-color: rgba(224,201,163,0.4); color: rgba(224,201,163,0.75);"
                set:html={social.icon}
              />
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-5 border-t" style="border-color: rgba(224,201,163,0.15);">
      <p class="font-montserrat text-[12px] font-normal leading-[19.6px]" style="color: rgba(244,243,242,0.7);">
        &copy; 2026 Dna Digital Consultancy. All rights reserved.
      </p>
      <div class="flex items-center gap-3">
        <a href="/privacy-policy" class="font-montserrat text-[12px] font-normal leading-[19.6px] hover:text-white transition-colors" style="color: rgba(244,243,242,0.7);">Privacy Policy</a>
        <span style="color: rgba(244,243,242,0.4);">|</span>
        <a href="/terms-and-conditions" class="font-montserrat text-[12px] font-normal leading-[19.6px] hover:text-white transition-colors" style="color: rgba(244,243,242,0.7);">Terms &amp; Conditions</a>
        <span style="color: rgba(244,243,242,0.4);">|</span>
        <a href="/cookie-preferences" class="font-montserrat text-[12px] font-normal leading-[19.6px] hover:text-white transition-colors" style="color: rgba(244,243,242,0.7);">Cookie Preferences</a>
      </div>
    </div>
  </div>
</footer>
