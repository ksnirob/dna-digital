      Talk to Our AI Concierge
    </a>
  </div>
</div>
</section>

<script>
import gsap from 'gsap';

type TabMeta = { id: string; label: string };

const tabsMeta: TabMeta[] = [
  { id: 'solution-engineering', label: 'Solution & Product Engineering' },
  { id: 'ai-growth', label: 'AI-Powered Growth & Experience' },
  { id: 'tech-leadership', label: 'Technology Leadership & Governance' },
  { id: 'ai-strategy', label: 'AI Strategy & Transformation' },
  { id: 'enterprise-digital', label: 'Enterprise Digital & Technology Transformation' },
  { id: 'ai-micro-agents', label: 'AI Micro-Agents & CRM Intelligence' },
  { id: 'digital-execution', label: 'Digital Execution & Delivery Enablement' },
];

// Initial active = ai-strategy (index 3) — center position
// tabsMeta is ordered so that with ai-strategy active:
//   left (outer→inner): solution, ai-growth, tech-leadership
//   right (inner→outer): enterprise-digital, ai-micro-agents, digital-execution

const panels = document.querySelectorAll<HTMLElement>('.expertise-panel');
let currentIndex = 3; // ai-strategy

// Heights: innermost (slot 2 on left, slot 0 on right) = card height, then progressively shorter outward
const HEIGHTS = {
  innermost: 360,  // slot closest to card
  middle: 320,
  outermost: 280,  // slot farthest from card
};

function buildTabButton(tab: TabMeta, side: 'left' | 'right', height: number): HTMLButtonElement {
  const btn = document.createElement('button');
  btn.className = 'expertise-tab-btn font-montserrat';
  btn.dataset.tab = tab.id;
  btn.dataset.side = side;
  btn.textContent = tab.label;
  const baseStyle = `display: flex; align-items: center; justify-content: center; padding: 18px 8px; width: 44px; height: ${height}px; font-size: 11px; font-weight: 500; letter-spacing: 0.01em; writing-mode: vertical-rl; text-orientation: mixed; line-height: 1.05; background-color: #AAB4A5; color: rgba(255,255,255,0.94); cursor: pointer; border: none; border-radius: 6px; box-shadow: 0 8px 20px rgba(92, 101, 91, 0.14); transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, opacity 0.3s;`;
  if (side === 'left') {
    btn.style.cssText = baseStyle + ' transform: rotate(180deg);';
  } else {
    btn.style.cssText = baseStyle;
  }
  btn.addEventListener('click', () => {
    const idx = tabsMeta.findIndex(t => t.id === tab.id);
    if (idx >= 0) showTab(idx);
  });
  return btn;
}

function getRotatedOrder(activeIdx: number): { left: TabMeta[]; right: TabMeta[] } {
  // Want exactly 3 left + 3 right around the active.
  // Left = 3 tabs before active (wrap), order: outermost → innermost
  // Right = 3 tabs after active (wrap), order: innermost → outermost
  const n = tabsMeta.length;
  const left: TabMeta[] = [];
  const right: TabMeta[] = [];
  // Left side: positions activeIdx-3, activeIdx-2, activeIdx-1 (outer→inner)
  for (let k = 3; k >= 1; k--) {
    left.push(tabsMeta[(activeIdx - k + n) % n]);
  }
  // Right side: activeIdx+1, activeIdx+2, activeIdx+3 (inner→outer)
  for (let k = 1; k <= 3; k++) {
    right.push(tabsMeta[(activeIdx + k) % n]);
  }
  return { left, right };
}

function renderStacks(activeIdx: number) {
  const { left, right } = getRotatedOrder(activeIdx);

  // LEFT SIDE: slot 0 = outermost (shortest), slot 1 = middle, slot 2 = innermost (tallest)
  const leftStack = document.querySelector<HTMLElement>('.expertise-side-stack[data-side="left"]')!;
  const leftSlots = leftStack.querySelectorAll<HTMLElement>('.expertise-tab-slot');
  const leftHeights = [HEIGHTS.outermost, HEIGHTS.middle, HEIGHTS.innermost];
  leftSlots.forEach((slot, i) => {
    slot.innerHTML = '';
    const tab = left[i];
    if (tab) slot.appendChild(buildTabButton(tab, 'left', leftHeights[i]));
  });

  // RIGHT SIDE: slot 0 = innermost (tallest), slot 1 = middle, slot 2 = outermost (shortest)
  const rightStack = document.querySelector<HTMLElement>('.expertise-side-stack[data-side="right"]')!;
  const rightSlots = rightStack.querySelectorAll<HTMLElement>('.expertise-tab-slot');
  const rightHeights = [HEIGHTS.innermost, HEIGHTS.middle, HEIGHTS.outermost];
  rightSlots.forEach((slot, i) => {
    slot.innerHTML = '';
    const tab = right[i];
    if (tab) slot.appendChild(buildTabButton(tab, 'right', rightHeights[i]));
  });
}

function showTab(index: number) {
  const n = tabsMeta.length;
  currentIndex = ((index % n) + n) % n;
  const id = tabsMeta[currentIndex].id;

  renderStacks(currentIndex);

  panels.forEach(panel => {
    const isActive = panel.dataset.panel === id;
    if (isActive) {
      panel.style.display = 'flex';
      gsap.fromTo(panel, { opacity: 0 }, { opacity: 1, duration: 0.45, ease: 'power2.out' });
    } else {
      panel.style.display = 'none';
    }
  });
}

document.getElementById('expertise-prev')?.addEventListener('click', () => showTab(currentIndex - 1));
document.getElementById('expertise-next')?.addEventListener('click', () => showTab(currentIndex + 1));

(window as any).showExpertiseTab = (tabId: string) => {
  const idx = tabsMeta.findIndex(t => t.id === tabId);
  if (idx >= 0) showTab(idx);
};

// Init — start at ai-strategy
showTab(3);
</script>

