---
// Our Expertise — exact Figma carousel layout
// Center card with vertical tab labels stacked on left and right sides

const tabs = [
  {
    id: 'ai-strategy',
    label: 'AI Strategy & Transformation',
    title: 'AI Strategy & Transformation',
    leftSide: true,
    capabilities: [
      'AI Strategy & Execution Roadmaps',
      'AI Maturity & Readiness Audits',
      'AI Governance, Risk & Compliance',
      'AI Opportunity Review & ROI Analysis',
      'AI CoE & Delivery Framework Development',
      'AI Technical Feasibility & Pilot Validation',
      'AI Program Leadership & Delivery Oversight',
    ],
    featuredCap: 'AI Strategy & Execution Roadmaps',
    featuredDesc: 'We develop clear, actionable AI strategies and roadmaps that align business priorities, technical feasibility, and organizational readiness. This eliminates execution paralysis, giving leaders a prioritized plan that converts AI hype into a measurable roadmap with realistic timelines and cross-functional alignment.',
  },
  {
    id: 'tech-leadership',
    label: 'Technology Leadership & Governance',
    title: 'Technology Leadership & Governance',
    leftSide: true,
    capabilities: [
      'Fractional CTO / Technology Leadership',
      'Technology Governance & Oversight',
      'IT Strategy & Portfolio Alignment',
      'Vendor Management & Technology Evaluation',
      'Technology Risk & Compliance Frameworks',
    ],
    featuredCap: 'Fractional CTO / Technology Leadership',
    featuredDesc: 'We provide senior-level technology oversight and leadership on a fractional basis, bringing enterprise-grade guidance to organizations that need CTO-level thinking without a full-time commitment.',
  },
  {
    id: 'ai-growth',
    label: 'AI-Powered Growth & Experience',
    title: 'AI-Powered Growth & Experience',
    leftSide: true,
    capabilities: [
      'AI-Driven Content & Creative Strategy',
      'Personalization & Recommendation Engines',
      'Intelligent Customer Experience Design',
      'Growth Automation & AI Marketing',
      'Analytics & Performance Intelligence',
    ],
    featuredCap: 'AI-Driven Content & Creative Strategy',
    featuredDesc: 'We help brands scale content, engagement, and growth using intelligent systems that amplify creativity and accelerate performance across all customer touchpoints.',
  },
  {
    id: 'solution-engineering',
    label: 'Solution & Product Engineering',
    title: 'Solution & Product Engineering',
    leftSide: false,
    capabilities: [
      'System Architecture & Design',
      'Cloud-Native Development',
      'API & Integration Engineering',
      'Performance Engineering',
      'DevSecOps & Automation',
    ],
    featuredCap: 'System Architecture & Design',
    featuredDesc: 'End-to-end engineering excellence from concept to deployment. We build mission-critical systems with architectural integrity and performance that scales to meet enterprise demands.',
  },
  {
    id: 'enterprise-digital',
    label: 'Enterprise Digital & Technology Transformation',
    title: 'Enterprise Digital & Technology Transformation',
    leftSide: false,
    capabilities: [
      'Legacy System Modernization',
      'Digital Core Transformation',
      'Enterprise Architecture Governance',
      'Technology Portfolio Rationalization',
      'Cloud Migration & Optimization',
    ],
    featuredCap: 'Legacy System Modernization',
    featuredDesc: 'Modernizing complex enterprise landscapes with precision. We eliminate legacy debt, enable digital-first capabilities, and ensure business continuity throughout every transformation initiative.',
  },
  {
    id: 'ai-micro-agents',
    label: 'AI Micro-Agents & CRM Intelligence',
    title: 'AI Micro-Agents & CRM Intelligence',
    leftSide: false,
    capabilities: [
      'AI Agent Design & Deployment',
      'CRM Intelligence & Automation',
      'Customer Journey Orchestration',
      'Sales Enablement Automation',
      'CRM Data Health & Governance',
    ],
    featuredCap: 'AI Agent Design & Deployment',
    featuredDesc: 'We deploy intelligent agents and CRM-powered automation that enhance customer engagement, streamline operations, and scale personalized experiences across your organization.',
  },
  {
    id: 'digital-execution',
    label: 'Digital Execution & Delivery Enablement',
    title: 'Digital Execution & Delivery Enablement',
    leftSide: false,
    capabilities: [
      'Program & Project Delivery Leadership',
      'Agile Transformation & Coaching',
      'Engineering Team Augmentation',
      'Delivery Health & Risk Management',
      'QA & Release Management',
    ],
    featuredCap: 'Program & Project Delivery Leadership',
    featuredDesc: 'We provide the architecture, engineering capacity, and delivery leadership needed to execute digital and AI initiatives with speed and quality. To ensure that happens, we help.',
  },
];

const leftTabs = tabs.filter(t => t.leftSide);
const rightTabs = tabs.filter(t => !t.leftSide);
---

<section id="expertise" class="w-full py-[100px]" style="background-color: #E9E4DD;">
  <div class="section-container">
    <!-- Section Header — centered -->
    <div class="text-center mb-12">
      <h2 class="font-montserrat font-bold leading-tight mb-4" style="font-size: 40px; color: #2A2A2A; font-variant: small-caps;">Our Expertise</h2>
      <div class="flex items-center justify-center gap-3 mb-5">
        <div class="h-px w-[100px]" style="background-color: #6B5E4A; opacity: 0.55;"></div>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="9" y="0" width="9" height="9" transform="rotate(45 9 0)" fill="#6B5E4A" opacity="0.85"/></svg>
        <div class="h-px w-[100px]" style="background-color: #6B5E4A; opacity: 0.55;"></div>
      </div>
      <h3 class="font-montserrat text-[22px] font-semibold leading-[28px] mb-4" style="color: #2A2A2A;">From Foresight to Execution</h3>
      <p class="font-merriweather text-[17px] font-normal leading-[29px] max-w-[700px] mx-auto" style="color: #2A2A2A;">
        Our tailored methodologies accelerate your digital and strategic transformation. Explore our areas of expertise below.
      </p>
    </div>

    <!-- Carousel Layout: left tabs | center card | right tabs -->
    <div class="expertise-carousel flex items-stretch gap-0 min-h-[380px] mb-14">

      <!-- Left side: stacked vertical tab labels -->
      <div class="flex items-stretch gap-1.5 mr-1.5">
        {leftTabs.map((tab, i) => (
          <button
            class="expertise-tab-btn flex items-center justify-center px-3 py-5 font-montserrat text-[11px] font-semibold uppercase tracking-widest transition-all duration-300 cursor-pointer"
            data-tab={tab.id}
            style="writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg); min-height: 120px; background-color: #818a79; color: rgba(255,255,255,0.75); letter-spacing: 0.12em;"
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Navigation Arrow Left -->
      <button id="expertise-prev" class="flex-shrink-0 w-9 flex items-center justify-center hover:bg-white/30 transition-colors duration-200 self-stretch" style="background: rgba(78,88,84,0.08);">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#4E5854" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <!-- Center Card: active tab content -->
      <div class="flex-1 bg-white shadow-sm min-h-[380px] overflow-hidden">
        {tabs.map((tab, i) => (
          <div class="expertise-panel hidden" data-panel={tab.id}>
            <!-- Card Title -->
            <div class="px-10 py-7 text-center" style="border-bottom: 1px solid rgba(78,88,84,0.15);">
              <h3 class="font-montserrat text-[20px] font-semibold leading-[26px]" style="color: #2A2A2A; font-variant: small-caps;">{tab.title}</h3>
            </div>
            <!-- Card Body: two columns -->
            <div class="flex gap-0 h-full" style="min-height: 300px;">
              <!-- Left: Core Capabilities list -->
              <div class="w-[45%] flex-shrink-0 p-8" style="border-right: 1px solid rgba(78,88,84,0.15);">
                <h4 class="font-montserrat text-[12px] font-bold uppercase tracking-widest mb-5" style="color: #6B5E4A; font-variant: small-caps; letter-spacing: 0.14em;">Core Capabilities</h4>
                <ul class="space-y-2.5">
                  {tab.capabilities.map((cap, ci) => (
                    <li>
                      <button
                        class="cap-btn text-left font-merriweather text-[13px] leading-[19px] transition-colors duration-200 hover:text-[#683547]"
                        data-desc-panel={tab.id + '-cap-' + ci}
                      >
                        • {cap}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
              <!-- Right: Featured description -->
              <div class="flex-1 p-8">
                <h5 class="font-montserrat text-[16px] font-semibold leading-[22px] mb-4" style="color: #2A2A2A;">{tab.featuredCap}</h5>
                <p class="font-merriweather text-[14px] font-normal leading-[24px]" style="color: #3A3A3A;">
                  <span class="text-[32px] font-bold leading-[24px] float-left mr-2 mt-0.5" style="color: #2A2A2A; font-family: 'Merriweather', serif;">{tab.featuredDesc.charAt(0)}</span>
                  {tab.featuredDesc.slice(1)}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation Arrow Right -->
      <button id="expertise-next" class="flex-shrink-0 w-9 flex items-center justify-center hover:bg-white/30 transition-colors duration-200 self-stretch" style="background: rgba(78,88,84,0.08);">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#4E5854" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <!-- Right side: stacked vertical tab labels -->
      <div class="flex items-stretch gap-1.5 ml-1.5">
        {rightTabs.map((tab, i) => (
          <button
            class="expertise-tab-btn flex items-center justify-center px-3 py-5 font-montserrat text-[11px] font-semibold uppercase tracking-widest transition-all duration-300 cursor-pointer"
            data-tab={tab.id}
            style="writing-mode: vertical-rl; text-orientation: mixed; min-height: 120px; background-color: #818a79; color: rgba(255,255,255,0.75); letter-spacing: 0.12em;"
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>

    <!-- CTA Row -->
    <div class="flex flex-col items-center gap-5">
      <p class="font-merriweather text-[18px] font-normal leading-[28px]" style="color: #060505;">Need guidance to the right path?</p>
      <a href="#contact" class="inline-flex items-center justify-center font-montserrat text-[13px] font-semibold tracking-[0.12em] uppercase text-white px-10 py-[14px] transition-all duration-300 hover:opacity-90" style="background-color: #683547; letter-spacing: 0.12em;">
        Talk to Our AI Concierge
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.expertise-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.expertise-panel');
  let currentIndex = 0;

  const tabIds = Array.from(tabBtns).map(btn => btn.dataset.tab as string);

  function showTab(index: number) {
    currentIndex = ((index % tabIds.length) + tabIds.length) % tabIds.length;
    const id = tabIds[currentIndex];

    tabBtns.forEach((btn, i) => {
      const isActive = i === currentIndex;
      btn.style.backgroundColor = isActive ? '#4E5854' : '#818a79';
      btn.style.color = isActive ? 'white' : 'rgba(255,255,255,0.75)';
    });

    panels.forEach(panel => {
      const isActive = panel.dataset.panel === id;
      if (isActive) {
        panel.classList.remove('hidden');
        panel.classList.add('block');
        gsap.fromTo(panel, { opacity: 0 }, { opacity: 1, duration: 0.45, ease: 'power2.out' });
      } else {
        panel.classList.add('hidden');
        panel.classList.remove('block');
      }
    });
  }

  tabBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => showTab(i));
  });

  document.getElementById('expertise-prev')?.addEventListener('click', () => showTab(currentIndex - 1));
  document.getElementById('expertise-next')?.addEventListener('click', () => showTab(currentIndex + 1));

  // Init first tab
  showTab(0);

  gsap.fromTo('.expertise-carousel', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: '.expertise-carousel', start: 'top 80%' } });
</script>
