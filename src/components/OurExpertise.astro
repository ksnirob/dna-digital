                ))}
              </ul>
            </div>
            <div class="expertise-panel-right" style="flex: 1; padding: 8px 0 0 28px; overflow: hidden;">
              <div class="expertise-feature-copy">
                <h5 class="font-montserrat expertise-feature-title" style="font-size: 14px; font-weight: 700; line-height: 20px; color: #36342F; margin-bottom: 10px;">{tab.featuredCap}</h5>
                <p class="font-merriweather expertise-drop-cap expertise-feature-desc" style="font-size: 12px; font-weight: 400; line-height: 1.5; color: #4C453E;">{tab.featuredDesc}</p>
              </div>
            </div>
          </div>
