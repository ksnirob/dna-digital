    <!-- Right side stack -->
    <div class="expertise-side-stack" data-side="right" style={`display: flex; flex-direction: row; align-items: center; gap: 0; margin-left: 8px; flex-shrink: 0; height: ${CARD_HEIGHT}px; position: relative;`}>
