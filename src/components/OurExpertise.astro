  align-items: flex-start;
  gap: 8px;
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  text-align: left;
}

.expertise-capability-btn:focus-visible {
  outline: 2px solid rgba(140, 120, 96, 0.45);
  outline-offset: 3px;
  border-radius: 4px;
}

.expertise-capability-dot {
  margin-top: 6px;
  flex-shrink: 0;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #A79682;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.expertise-capability-label {
  text-align: left;
  font-family: 'Merriweather', serif;
  font-size: 12px;
  line-height: 1.45;
