  </div>

  <!-- Carousel Layout -->
  <div class="expertise-carousel" style={`position: relative; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-bottom: 56px; max-width: 1050px; margin-left: auto; margin-right: auto; padding-left: 64px; padding-right: 64px;`}>

    <!-- Left side stack: 3 slot containers (slot 0 = outermost, slot 2 = innermost) -->
    <div class="expertise-side-stack" data-side="left" style={`display: flex; flex-direction: row; align-items: center; gap: 0; margin-right: 8px; flex-shrink: 0; height: ${CARD_HEIGHT}px; position: relative;`}>
