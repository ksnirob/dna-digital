        <div class="expertise-panel" data-panel={tab.id} style={`position: absolute; inset: 0; z-index: 2; display: ${i === 0 ? 'flex' : 'none'}; flex-direction: column;`}>
          <div style="padding: 32px 32px 14px; text-align: center; flex-shrink: 0;">
            <h3 class="font-montserrat" style="font-size: 17px; font-weight: 700; line-height: 22px; color: #36342F; letter-spacing: 0;">{tab.title}</h3>
          </div>
          <div class="expertise-panel-content" style="display: flex; flex-direction: row; padding: 0 32px 28px; flex: 1; min-height: 0; overflow: hidden;">
            <div class="expertise-panel-left" style="width: 46%; flex-shrink: 0; padding: 8px 22px 0 0; border-right: 1px solid rgba(160, 145, 120, 0.28); overflow: hidden;">
              <h4 class="font-montserrat" style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: #36342F; margin-bottom: 16px;">Core Capabilities</h4>
              <ul style="list-style: none; padding: 0; margin: 0;">
                {tab.capabilities.map((cap, ci) => (
                  <li style="display: flex; align-items: flex-start; gap: 8px; margin-bottom: 7px;">
                    <span style={`margin-top: 6px; flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background-color: ${ci === 0 ? '#8C7860' : '#A79682'};`}></span>
                    <span style={`text-align: left; font-family: 'Merriweather', serif; font-size: 12px; line-height: 1.45; color: ${ci === 0 ? '#6B5E4A' : '#564A3D'}; font-weight: ${ci === 0 ? '700' : '400'};`}>{cap}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="expertise-panel-right" style="flex: 1; padding: 8px 0 0 28px; overflow: hidden;">
              <h5 class="font-montserrat" style="font-size: 14px; font-weight: 700; line-height: 20px; color: #36342F; margin-bottom: 10px;">{tab.featuredCap}</h5>
